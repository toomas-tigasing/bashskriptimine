#!/bin/bash
#
# Kasutajad ja paroolid eraldi failides
# Kasutus: ./kasutajad_ja_paroolid kasutajate_fail paroolide_fail

if [ $# -ne 2 ]; then
    echo "Kasutusjuhend: $0 kasutajate_fail paroolide_fail"
    exit 1
fi

kasutajad=$1
paroolid=$2

if [ ! -f "$kasutajad" -o ! -r "$kasutajad" ]; then
    echo "Probleem failiga $kasutajad"
    exit 1
fi

if [ ! -f "$paroolid" -o ! -r "$paroolid" ]; then
    echo "Probleem failiga $paroolid"
    exit 1
fi

echo "Failid on korras"

for rida in $(paste -d: "$kasutajad" "$paroolid")
do
    kasutajanimi=$(echo "$rida" | cut -f1 -d:)

    useradd "$kasutajanimi" -m -s /bin/bash
    kasu_tulemus=$?

    if [ $kasu_tulemus -eq 0 ]; then
        echo "$rida" | chpasswd
        echo "Kasutaja $kasutajanimi on lisatud parooliga"
        cat /etc/passwd | grep "$kasutajanimi"
        ls -la /home/"$kasutajanimi"
    else
        echo "Probleem kasutaja $kasutajanimi lisamisega"
        echo "Probleemi kood on $kasu_tulemus"
    fi
done
